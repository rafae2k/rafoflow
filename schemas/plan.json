{
  "type": "object",
  "additionalProperties": false,
  "required": ["direction", "why", "risk", "eliminated_options", "alternatives", "steps", "exit_criteria", "risks", "failure_modes", "verification", "outcome", "open_question"],
  "properties": {
    "direction": { "type": "string" },
    "why": { "type": "string" },
    "risk": { "type": "string", "enum": ["A", "B", "C"] },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "effect", "detection", "undo"],
        "properties": { "mode": { "type": "string" }, "effect": { "type": "string" }, "detection": { "type": "string" }, "undo": { "type": "string" } }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "where", "command"],
        "properties": { "claim": { "type": "string" }, "where": { "type": "string" }, "command": { "type": "string" } }
      }
    },
    "eliminated_options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "reason"],
        "properties": { "option": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "why_rejected"],
        "properties": { "option": { "type": "string" }, "why_rejected": { "type": "string" } }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "files"],
        "properties": { "action": { "type": "string" }, "files": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "exit_criteria": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "containment"],
        "properties": { "risk": { "type": "string" }, "containment": { "type": "string" } }
      }
    },
    "outcome": { "type": "string", "enum": ["done", "needs_poc", "blocked"] },
    "open_question": { "type": "string" }
  }
}
