+import type { RefundLine } from "../events/types.ts";
+import { num, str, type Db } from "./database.ts";
+
+export interface Refund {
+  id: string;
+  order_id: string;
+  amount_cents: number;
+  lines: RefundLine[];
+  occurred_at: string;
+  applied_at: string;
+}
+
+/** @returns false when this refund id was already recorded. */
+export function insertRefund(db: Db, refund: Refund): boolean {
+  const result = db
+    .prepare(
+      `INSERT INTO refunds (id, order_id, amount_cents, lines_json, occurred_at, applied_at)
+       VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (id) DO NOTHING`,
+    )
+    .run(refund.id, refund.order_id, refund.amount_cents, JSON.stringify(refund.lines), refund.occurred_at, refund.applied_at);
+  return Number(result.changes) === 1;
+}
+
+export function listRefunds(db: Db, orderId: string): Refund[] {
+  return db
+    .prepare("SELECT * FROM refunds WHERE order_id = ? ORDER BY occurred_at, id")
+    .all(orderId)
+    .map((row) => ({
+      id: str(row.id),
+      order_id: str(row.order_id),
+      amount_cents: num(row.amount_cents),
+      lines: JSON.parse(str(row.lines_json)) as RefundLine[],
+      occurred_at: str(row.occurred_at),
+      applied_at: str(row.applied_at),
+    }));
+}
