diff --git a/src/handlers/refunds.ts b/src/handlers/refunds.ts
new file mode 100644
index 0000000..92b7bcc
--- /dev/null
+++ b/src/handlers/refunds.ts
@@ -0,0 +1,94 @@
+import { recordDomainEvent } from "../db/bookkeeping-repo.ts";
+import { transaction } from "../db/database.ts";
+import { decrementItemQuantity, listOrderItems } from "../db/items-repo.ts";
+import { getOrder, updateOrder } from "../db/orders-repo.ts";
+import { insertRefund } from "../db/refunds-repo.ts";
+import type { EventEnvelope } from "../events/envelope.ts";
+import type { RefundLine } from "../events/types.ts";
+import { PermanentError, RetryableError } from "../lib/errors.ts";
+import { now, type HandlerContext, type HandlerOutcome } from "./context.ts";
+
+function validateLines(lines: unknown): RefundLine[] {
+  if (!Array.isArray(lines) || lines.length === 0) {
+    throw new PermanentError("invalid_refund", "lines must be a non-empty array");
+  }
+  return lines.map((raw, index) => {
+    const line = raw as Partial<RefundLine> | null;
+    if (!line || typeof line.sku !== "string" || !Number.isInteger(line.quantity) || (line.quantity as number) <= 0) {
+      throw new PermanentError("invalid_refund", `lines[${index}] needs a sku and a positive quantity`);
+    }
+    return { sku: line.sku, quantity: line.quantity as number };
+  });
+}
+
+/**
+ * Applies a partial refund: lowers the order total and the refunded item
+ * quantities, and records `order.partially_refunded` once per refund id.
+ *
+ * Order-independent: a refund that arrives before `order.created` (or before
+ * the items it refers to) is retried with backoff instead of being dropped.
+ */
+export async function applyPartialRefund(
+  ctx: HandlerContext,
+  envelope: EventEnvelope<"order.partially_refunded">,
+): Promise<HandlerOutcome> {
+  const p = envelope.payload;
+  if (typeof p.refund_id !== "string" || p.refund_id.length === 0) {
+    throw new PermanentError("invalid_refund", "refund_id is required");
+  }
+  if (!Number.isInteger(p.amount_cents) || p.amount_cents <= 0) {
+    throw new PermanentError("invalid_refund", "amount_cents must be a positive integer");
+  }
+  const lines = validateLines(p.lines);
+
+  const order = getOrder(ctx.db, p.order_id);
+  if (!order || order.created_at === null || order.total_cents === null) {
+    throw new RetryableError("refund_order_not_ready", `order ${p.order_id} not created yet`);
+  }
+  const totalCents = order.total_cents;
+  const items = new Map(listOrderItems(ctx.db, p.order_id).map((i) => [i.sku, i]));
+
+  const at = now(ctx);
+  const applied = transaction(ctx.db, () => {
+    const isNew = insertRefund(ctx.db, {
+      id: p.refund_id,
+      order_id: p.order_id,
+      amount_cents: p.amount_cents,
+      lines,
+      occurred_at: envelope.occurred_at,
+      applied_at: at,
+    });
+    if (!isNew) return false;
+    for (const line of lines) {
+      const item = items.get(line.sku);
+      if (!item) throw new RetryableError("refund_item_unknown", `order ${p.order_id} has no item ${line.sku} yet`);
+      if (line.quantity > item.quantity) {
+        throw new PermanentError("refund_exceeds_quantity", `refunding ${line.quantity} of ${item.quantity} ${line.sku}`);
+      }
+      decrementItemQuantity(ctx.db, p.order_id, line.sku, line.quantity);
+    }
+    if (p.amount_cents > totalCents) {
+      throw new PermanentError("refund_exceeds_total", `refund ${p.amount_cents} > total ${totalCents}`);
+    }
+    // An items snapshot older than this refund must not roll the quantities back.
+    const asOf = order.items_as_of && order.items_as_of > envelope.occurred_at ? order.items_as_of : envelope.occurred_at;
+    updateOrder(ctx.db, p.order_id, { total_cents: totalCents - p.amount_cents, items_as_of: asOf }, at);
+    recordDomainEvent(ctx.db, {
+      id: `refunded:${p.refund_id}`,
+      order_id: p.order_id,
+      type: "order.partially_refunded",
+      payload: { refund_id: p.refund_id, amount_cents: p.amount_cents, lines },
+      occurred_at: envelope.occurred_at,
+    });
+    return true;
+  });
+
+  if (!applied) {
+    ctx.log.info({ event: "refund.already_applied", order_id: p.order_id, refund_id: p.refund_id });
+    ctx.metrics.increment("refund_already_applied");
+    return "noop";
+  }
+  ctx.metrics.increment("order_partially_refunded");
+  ctx.log.info({ event: "refund.applied", order_id: p.order_id, refund_id: p.refund_id, amount_cents: p.amount_cents });
+  return "applied";
+}
