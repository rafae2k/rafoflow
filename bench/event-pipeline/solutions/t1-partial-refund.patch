diff --git a/test/refunds.test.ts b/test/refunds.test.ts
new file mode 100644
index 0000000..830bdc1
--- /dev/null
+++ b/test/refunds.test.ts
@@ -0,0 +1,70 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { listDeadLetters, listDomainEvents } from "../src/db/bookkeeping-repo.ts";
+import { listOrderItems } from "../src/db/items-repo.ts";
+import { getOrder } from "../src/db/orders-repo.ts";
+import { listRefunds } from "../src/db/refunds-repo.ts";
+import { created, ev, minutes, paid, setup } from "./helpers.ts";
+
+function refund(orderId: string, refundId: string, opts: { id?: string; at?: string; quantity?: number } = {}) {
+  return ev(
+    "order.partially_refunded",
+    { order_id: orderId, refund_id: refundId, amount_cents: 15900, lines: [{ sku: "WHEY-900", quantity: opts.quantity ?? 1 }] },
+    opts,
+  );
+}
+
+describe("partial refunds", () => {
+  it("lowers total and quantities and records a domain event", async () => {
+    const { pipeline, db, warehouse } = setup();
+    pipeline.publish(created("o1", { at: minutes(1) }));
+    pipeline.publish(paid("o1", { at: minutes(2) }));
+    await pipeline.drain();
+    pipeline.publish(refund("o1", "r1", { at: minutes(10) }));
+    await pipeline.drain();
+
+    assert.equal(getOrder(db, "o1")?.total_cents, 40700 - 15900);
+    assert.equal(listOrderItems(db, "o1").find((i) => i.sku === "WHEY-900")?.quantity, 1);
+    assert.equal(listRefunds(db, "o1").length, 1);
+    assert.deepEqual(
+      listDomainEvents(db, "o1").map((e) => e.type),
+      ["order.dispatched", "order.partially_refunded"],
+    );
+    assert.equal(warehouse.calls.length, 1);
+  });
+
+  it("applies the same refund id once even under a new envelope id", async () => {
+    const { pipeline, db } = setup();
+    pipeline.publish(created("o1", { at: minutes(1) }));
+    await pipeline.drain();
+    pipeline.publish(refund("o1", "r1", { id: "a", at: minutes(10) }));
+    await pipeline.drain();
+    pipeline.publish(refund("o1", "r1", { id: "b", at: minutes(10) }));
+    await pipeline.drain();
+    assert.equal(getOrder(db, "o1")?.total_cents, 40700 - 15900);
+    assert.equal(listOrderItems(db, "o1").find((i) => i.sku === "WHEY-900")?.quantity, 1);
+  });
+
+  it("waits for the order when the refund arrives first", async () => {
+    const { pipeline, db, clock } = setup();
+    pipeline.publish(refund("o1", "r1", { at: minutes(10) }));
+    const first = await pipeline.drain();
+    assert.equal(first.retry_scheduled, 1);
+    pipeline.publish(created("o1", { at: minutes(1) }));
+    await pipeline.drain();
+    clock.advance(60_000);
+    await pipeline.drain();
+    assert.equal(getOrder(db, "o1")?.total_cents, 40700 - 15900);
+  });
+
+  it("dead-letters a refund for more than was bought, without partial writes", async () => {
+    const { pipeline, db } = setup();
+    pipeline.publish(created("o1", { at: minutes(1) }));
+    await pipeline.drain();
+    pipeline.publish(refund("o1", "r1", { quantity: 5 }));
+    await pipeline.drain();
+    assert.equal(listDeadLetters(db)[0]?.error_slug, "refund_exceeds_quantity");
+    assert.equal(getOrder(db, "o1")?.total_cents, 40700);
+    assert.equal(listRefunds(db, "o1").length, 0);
+  });
+});
