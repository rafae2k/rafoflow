+/**
+ * Atomically claims the right to call the warehouse for an order. A single
+ * conditional UPDATE, so of N concurrent callers exactly one gets
+ * `changes = 1`. A claim can be taken when none exists, when it is older than
+ * `staleBefore` (abandoned), or when `token` already owns it (redelivery).
+ * @returns true when the caller now holds the claim.
+ */
+export function claimDispatch(db: Db, orderId: string, token: string, at: string, staleBefore: string): boolean {
+  const result = db
+    .prepare(
+      `UPDATE orders SET dispatch_claim_token = ?, dispatch_claimed_at = ?, updated_at = ?
+       WHERE id = ? AND dispatched_at IS NULL AND canceled_at IS NULL AND paid_at IS NOT NULL
+         AND (dispatch_claim_token IS NULL OR dispatch_claim_token = ? OR dispatch_claimed_at < ?)`,
+    )
+    .run(token, at, at, orderId, token, staleBefore);
+  return Number(result.changes) === 1;
+}
+
+/** Drops a claim after a failed warehouse call so the retry (or anyone) can claim again. */
+export function releaseDispatchClaim(db: Db, orderId: string, token: string): void {
+  db.prepare(
+    `UPDATE orders SET dispatch_claim_token = NULL, dispatch_claimed_at = NULL
+     WHERE id = ? AND dispatch_claim_token = ? AND dispatched_at IS NULL`,
+  ).run(orderId, token);
+}
+
