diff --git a/test/dispatch.test.ts b/test/dispatch.test.ts
new file mode 100644
index 0000000..b67a6b7
--- /dev/null
+++ b/test/dispatch.test.ts
@@ -0,0 +1,88 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { FakeWarehouse } from "../src/adapters/fake-warehouse.ts";
+import { openDatabase } from "../src/db/database.ts";
+import { claimDispatch, getOrder, releaseDispatchClaim } from "../src/db/orders-repo.ts";
+import { DISPATCH_CLAIM_TTL_MS } from "../src/fulfillment/dispatch.ts";
+import { createManualClock, toIso } from "../src/lib/clock.ts";
+import { createMetrics } from "../src/lib/metrics.ts";
+import { createPipeline } from "../src/pipeline.ts";
+import { created, ev, ITEMS, minutes, paid, setup } from "./helpers.ts";
+
+describe("claimDispatch", () => {
+  it("lets exactly one token claim, honors ownership and staleness", async () => {
+    const { pipeline, db } = setup();
+    pipeline.publish(created("o1", { items: null }));
+    pipeline.publish(paid("o1"));
+    await pipeline.drain();
+
+    const t0 = minutes(100);
+    const stale = toIso(Date.parse(t0) - DISPATCH_CLAIM_TTL_MS);
+    assert.equal(claimDispatch(db, "o1", "a", t0, stale), true);
+    assert.equal(claimDispatch(db, "o1", "b", t0, stale), false);
+    assert.equal(claimDispatch(db, "o1", "a", t0, stale), true, "owner can resume its claim");
+
+    const later = toIso(Date.parse(t0) + DISPATCH_CLAIM_TTL_MS + 1);
+    assert.equal(claimDispatch(db, "o1", "b", later, toIso(Date.parse(later) - DISPATCH_CLAIM_TTL_MS)), true, "stale claim is taken over");
+
+    releaseDispatchClaim(db, "o1", "a");
+    assert.equal(getOrder(db, "o1")?.dispatch_claim_token, "b", "only the owner can release");
+  });
+});
+
+describe("maybeDispatch", () => {
+  it("waits for items instead of dispatching an empty order", async () => {
+    const { pipeline, db, warehouse, metrics } = setup();
+    pipeline.publish(paid("o1"));
+    await pipeline.drain();
+    assert.equal(warehouse.calls.length, 0);
+    assert.equal(getOrder(db, "o1")?.status, "paid");
+    assert.equal(metrics.total("fulfillment_waiting_for_items"), 1);
+
+    pipeline.publish(created("o1"));
+    await pipeline.drain();
+    assert.equal(warehouse.calls.length, 1);
+    assert.equal(warehouse.calls[0]?.lines.length, ITEMS.length);
+  });
+
+  it("dispatches once when paid and items_updated share a batch", async () => {
+    const { pipeline, warehouse, metrics } = setup();
+    pipeline.publish(created("o1"));
+    await pipeline.drain();
+    pipeline.publish(paid("o1"));
+    pipeline.publish(ev("order.items_updated", { order_id: "o1", items: ITEMS }));
+    pipeline.publish(paid("o1", { id: "redelivered-with-new-id" }));
+    await pipeline.drain();
+    assert.equal(warehouse.calls.length, 1);
+    assert.equal(metrics.total("fulfillment_claim_contended"), 2);
+  });
+
+  it("dispatches once across two workers sharing the database", async () => {
+    const clock = createManualClock();
+    const db = openDatabase();
+    const warehouse = new FakeWarehouse({ latencyTicks: 5 });
+    const metrics = createMetrics();
+    const a = createPipeline({ db, warehouse, clock, metrics, random: () => 0.5 });
+    const b = createPipeline({ db, warehouse, clock, metrics, random: () => 0.5 });
+    a.publish(created("o1"));
+    await a.drain();
+    a.publish(paid("o1", { id: "p-a" }));
+    b.publish(paid("o1", { id: "p-b" }));
+    await Promise.all([a.drain(), b.drain()]);
+    assert.equal(warehouse.calls.length, 1);
+    assert.ok(getOrder(db, "o1")?.dispatched_at);
+  });
+
+  it("releases the claim when the warehouse fails so the retry can dispatch", async () => {
+    const { pipeline, db, warehouse, clock } = setup();
+    pipeline.publish(created("o1"));
+    await pipeline.drain();
+    warehouse.failNext(1);
+    pipeline.publish(paid("o1"));
+    await pipeline.drain();
+    assert.equal(getOrder(db, "o1")?.dispatch_claim_token, null);
+    clock.advance(60_000);
+    await pipeline.drain();
+    assert.equal(warehouse.calls.length, 1);
+  });
+});
