+/**
+ * Hands out unique ids within one page: the first "intro" stays "intro", the
+ * next ones become "intro-1", "intro-2", ... skipping ids already taken.
+ */
+class UniqueIds {
+  readonly #taken = new Set<string>();
+  readonly #counters = new Map<string, number>();
+
+  claim(base: string): string {
+    let id = base;
+    let n = this.#counters.get(base) ?? 0;
+    while (this.#taken.has(id)) {
+      n++;
+      id = `${base}-${n}`;
+    }
+    this.#counters.set(base, n);
+    this.#taken.add(id);
+    return id;
+  }
+}
+
 function startsBlock(line: string): boolean {
   return FENCE.test(line) || HEADING.test(line) || BULLET.test(line) || ORDERED.test(line);
 }
diff --git a/src/markdown/toc.ts b/src/markdown/toc.ts
new file mode 100644
index 0000000..e5c34e3
--- /dev/null
+++ b/src/markdown/toc.ts
@@ -0,0 +1,40 @@
+import { escapeAttr, escapeHtml } from "../html.ts";
+import type { Heading } from "./render.ts";
+
+/** Heading levels included in the table of contents. */
+export const TOC_LEVELS: readonly number[] = [2, 3];
+
+/**
+ * Renders a page's table of contents from its headings (h2 and h3), linking
+ * to their ids. h3 entries are nested under the preceding h2. Returns "" when
+ * there is nothing to list.
+ */
+export function renderToc(headings: readonly Heading[]): string {
+  const entries = headings.filter((h) => TOC_LEVELS.includes(h.level));
+  if (entries.length === 0) return "";
+
+  let html = '<nav class="toc"><ul>';
+  let openSub = false;
+  let openItem = false;
+  for (const h of entries) {
+    const link = `<a href="#${escapeAttr(h.id)}">${escapeHtml(h.text)}</a>`;
+    if (h.level === 3 && openItem) {
+      if (!openSub) {
+        html += "<ul>";
+        openSub = true;
+      }
+      html += `<li>${link}</li>`;
+      continue;
+    }
+    if (openSub) {
+      html += "</ul>";
+      openSub = false;
+    }
+    if (openItem) html += "</li>";
+    html += `<li>${link}`;
+    openItem = true;
+  }
+  if (openSub) html += "</ul>";
+  if (openItem) html += "</li>";
+  return `${html}</ul></nav>`;
+}
