+/**
+ * A custom slug from front matter: one or more path segments made of letters,
+ * digits, "-" and "_", separated by "/". No "." or ".." segments, no leading
+ * or trailing "/", no extension. This keeps slugs from escaping the output dir
+ * (invariant 5) and from carrying markup into URLs.
+ */
+const SLUG = /^[A-Za-z0-9_-]+(\/[A-Za-z0-9_-]+)*$/;
+
+export function isValidSlug(slug: string): boolean {
+  return SLUG.test(slug);
+}
+
+/** Route for a validated slug: "product/landing" -> "product/landing.html". */
+export function routeForSlug(slug: string): string {
+  if (!isValidSlug(slug)) throw new PathError(slug, `invalid slug: ${JSON.stringify(slug)}`);
+  return `${slug}.html`;
+}
