+/** Two pages (e.g. one with a custom slug) must never overwrite each other's output. */
+function assertUniqueRoutes(pages: readonly Page[]): void {
+  const seen = new Map<string, string>();
+  for (const page of pages) {
+    const key = page.route.toLowerCase(); // case-insensitive file systems would collide too
+    const other = seen.get(key);
+    if (other !== undefined) throw new DuplicateRouteError(page.route, [other, page.sourcePath]);
+    seen.set(key, page.sourcePath);
+  }
+}
