new file mode 100644
index 0000000..25dd948
--- /dev/null
+++ b/test/slug.test.ts
@@ -0,0 +1,28 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { DuplicateRouteError, FrontMatterError } from "../src/errors.ts";
+import { isValidSlug } from "../src/paths.ts";
+import { buildSite } from "./helpers.ts";
+
+describe("custom slugs", () => {
+  it("validates slugs", () => {
+    for (const ok of ["a", "product/landing", "v2_docs/x-y"]) assert.equal(isValidSlug(ok), true, ok);
+    for (const bad of ["", "/a", "a/", "../a", "a/../b", "a/./b", "a.html", "a b", "a//b", '"><x']) {
+      assert.equal(isValidSlug(bad), false, bad);
+    }
+  });
+
+  it("writes the page at its slug and rewrites links to it", async () => {
+    const { out, result } = await buildSite({ "index.md": "[p](deep/promo.md)", "deep/promo.md": "---\nslug: landing\n---\nP" });
+    assert.deepEqual(result.written, ["index.html", "landing.html"]);
+    assert.match(await out("index.html"), /<a href="landing\.html">p<\/a>/);
+  });
+
+  it("rejects unsafe slugs with a front matter error", async () => {
+    await assert.rejects(buildSite({ "a.md": "---\nslug: ../../etc/x\n---\n" }), FrontMatterError);
+  });
+
+  it("rejects two pages with the same output path", async () => {
+    await assert.rejects(buildSite({ "a.md": "---\nslug: b\n---\n", "b.md": "B" }), DuplicateRouteError);
+  });
+});
