@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { build } from "../src/build.ts";
+import { hashOf, MANIFEST_FILE, stableStringify } from "../src/incremental/manifest.ts";
+import { readingTime } from "../src/plugins/reading-time.ts";
+import { OUT, siteFs, SRC } from "./helpers.ts";
+
+describe("incremental builds", () => {
+  it("stableStringify sorts keys at every level", () => {
+    assert.equal(stableStringify({ b: 1, a: { d: [2, { y: 1, x: 2 }], c: undefined } }), '{"a":{"c":null,"d":[2,{"x":2,"y":1}]},"b":1}');
+    assert.equal(hashOf({ a: 1, b: 2 }), hashOf({ b: 2, a: 1 }));
+  });
+
+  it("writes a deterministic manifest only in incremental mode", async () => {
+    const a = siteFs({ "a.md": "A", "b.md": "B" });
+    const b = siteFs({ "b.md": "B", "a.md": "A" });
+    await build({ fs: a, srcDir: SRC, outDir: OUT, incremental: true });
+    await build({ fs: b, srcDir: SRC, outDir: OUT, incremental: true });
+    assert.deepEqual(a.snapshot(OUT), b.snapshot(OUT));
+    assert.ok(await a.exists(`${OUT}/${MANIFEST_FILE}`));
+
+    await build({ fs: a, srcDir: SRC, outDir: OUT });
+    assert.equal(await a.exists(`${OUT}/${MANIFEST_FILE}`), false);
+  });
+
+  it("reports only the files it rewrote", async () => {
+    const fs = siteFs({ "a.md": "A", "b.md": "B" });
+    await build({ fs, srcDir: SRC, outDir: OUT, incremental: true });
+    await fs.writeFile(`${SRC}/b.md`, "B changed");
+    const result = await build({ fs, srcDir: SRC, outDir: OUT, incremental: true });
+    assert.deepEqual(result.written, ["b.html"]);
+  });
+
+  it("rebuilds everything when a plugin option changes", async () => {
+    const fs = siteFs({ "a.md": "word ".repeat(300), "b.md": "B" });
+    await build({ fs, srcDir: SRC, outDir: OUT, incremental: true, plugins: [readingTime()] });
+    const result = await build({ fs, srcDir: SRC, outDir: OUT, incremental: true, plugins: [readingTime({ wordsPerMinute: 100 })] });
+    assert.deepEqual(result.written, ["a.html", "b.html"]);
+    assert.match(await fs.readFile(`${OUT}/a.html`), /3 min read/);
+  });
+
+  it("re-renders a page whose output file went missing", async () => {
+    const fs = siteFs({ "a.md": "A", "b.md": "B" });
+    await build({ fs, srcDir: SRC, outDir: OUT, incremental: true });
+    await fs.rm(`${OUT}/a.html`);
+    const result = await build({ fs, srcDir: SRC, outDir: OUT, incremental: true });
+    assert.deepEqual(result.written, ["a.html"]);
+  });
+
+  it("falls back to a full build when the manifest is corrupt", async () => {
+    const fs = siteFs({ "a.md": "A" });
+    await build({ fs, srcDir: SRC, outDir: OUT, incremental: true });
+    await fs.writeFile(`${OUT}/${MANIFEST_FILE}`, "{not json");
+    await fs.writeFile(`${OUT}/stale.html`, "old");
+    const result = await build({ fs, srcDir: SRC, outDir: OUT, incremental: true });
+    assert.deepEqual(result.written, ["a.html"]);
+    assert.equal(await fs.exists(`${OUT}/stale.html`), false);
+  });
+});
