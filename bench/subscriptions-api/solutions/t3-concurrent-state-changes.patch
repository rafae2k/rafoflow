diff --git a/test/concurrency.test.ts b/test/concurrency.test.ts
new file mode 100644
index 0000000..99c818a
--- /dev/null
+++ b/test/concurrency.test.ts
@@ -0,0 +1,77 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { LOCK_TTL_MS } from "../src/repositories/subscriptions.ts";
+import { createTestContext, seedSubscription } from "./helpers.ts";
+
+/** Gateway whose charges stay pending until `release()` is called. */
+function holdGateway(t: ReturnType<typeof createTestContext>) {
+  const pending: Array<() => void> = [];
+  const original = t.gateway.charge.bind(t.gateway);
+  t.gateway.charge = async (req) => {
+    await new Promise<void>((resolve) => pending.push(resolve));
+    return original(req);
+  };
+  return {
+    release() {
+      for (const resolve of pending.splice(0)) resolve();
+    },
+  };
+}
+
+describe("concurrent state changes", () => {
+  it("answers 409 operation_in_progress while a catch-up charge is in flight", async () => {
+    const t = createTestContext({ now: "2026-01-10T12:00:00.000Z" });
+    const { subscriptionId } = await seedSubscription(t);
+    await t.call("POST", `/subscriptions/${subscriptionId}/pause`);
+    t.setNow("2026-02-15T00:00:00.000Z");
+    const hold = holdGateway(t);
+
+    const resume = t.call("POST", `/subscriptions/${subscriptionId}/resume`);
+    await Promise.resolve();
+    for (const action of ["resume", "cancel"]) {
+      const res = await t.call("POST", `/subscriptions/${subscriptionId}/${action}`);
+      assert.equal(res.status, 409, action);
+      assert.equal(res.body.error.code, "operation_in_progress", action);
+    }
+    // Pausing a paused subscription is invalid regardless of the lock.
+    assert.equal((await t.call("POST", `/subscriptions/${subscriptionId}/pause`)).status, 409);
+    hold.release();
+    assert.equal((await resume).status, 200);
+
+    const sub = await t.call("GET", `/subscriptions/${subscriptionId}`);
+    assert.equal(sub.body.status, "active");
+    assert.equal("lock_token" in sub.body, false);
+    const events = await t.call("GET", `/subscriptions/${subscriptionId}/events`);
+    assert.equal(events.body.data.filter((e: { type: string }) => e.type === "subscription.resumed").length, 1);
+  });
+
+  it("renewals skip a locked subscription and cancel waits for the renewal", async () => {
+    const t = createTestContext({ now: "2026-01-10T12:00:00.000Z" });
+    const { subscriptionId } = await seedSubscription(t);
+    t.setNow("2026-02-10T12:00:00.000Z");
+    const hold = holdGateway(t);
+
+    const run = t.app.billing.runDueRenewals();
+    await Promise.resolve();
+    const cancel = await t.call("POST", `/subscriptions/${subscriptionId}/cancel`);
+    assert.equal(cancel.status, 409);
+    assert.deepEqual(await t.app.billing.runDueRenewals(), { charged: 0, failed: 0, skipped: 1 });
+    hold.release();
+    assert.deepEqual(await run, { charged: 1, failed: 0 });
+
+    const after = await t.call("POST", `/subscriptions/${subscriptionId}/cancel`);
+    assert.equal(after.status, 200);
+    assert.equal(after.body.next_charge_at, null);
+  });
+
+  it("a lock older than LOCK_TTL_MS no longer blocks other requests", async () => {
+    const t = createTestContext({ now: "2026-01-10T12:00:00.000Z" });
+    const { subscriptionId } = await seedSubscription(t);
+    t.db
+      .prepare("UPDATE subscriptions SET lock_token = 'lock_dead', locked_at = ? WHERE id = ?")
+      .run("2026-01-10T12:00:00.000Z", subscriptionId);
+    assert.equal((await t.call("POST", `/subscriptions/${subscriptionId}/pause`)).status, 409);
+    t.setNow(new Date(Date.parse("2026-01-10T12:00:00.000Z") + LOCK_TTL_MS + 1000).toISOString());
+    assert.equal((await t.call("POST", `/subscriptions/${subscriptionId}/pause`)).status, 200);
+  });
+});
