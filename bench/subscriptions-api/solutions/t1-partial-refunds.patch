--- /dev/null
+++ b/src/repositories/refunds.ts
@@ -0,0 +1,26 @@
+import type { Database } from "../db/database.ts";
+import type { Refund } from "../domain/types.ts";
+import { assertCents } from "../lib/money.ts";
+
+export function insertRefund(db: Database, refund: Refund): Refund {
+  assertCents(refund.amount_cents);
+  db.prepare(
+    "INSERT INTO refunds (id, charge_id, subscription_id, amount_cents, reason, created_at) VALUES (?, ?, ?, ?, ?, ?)",
+  ).run(refund.id, refund.charge_id, refund.subscription_id, refund.amount_cents, refund.reason, refund.created_at);
+  return refund;
+}
+
+/** Total already refunded for a charge, in integer cents. */
+export function sumRefundedCents(db: Database, chargeId: string): number {
+  const row = db
+    .prepare("SELECT COALESCE(SUM(amount_cents), 0) AS total FROM refunds WHERE charge_id = ?")
+    .get(chargeId) as { total: number };
+  return row.total;
+}
+
+export function listRefundsForCharge(db: Database, chargeId: string): Refund[] {
+  return db
+    .prepare("SELECT * FROM refunds WHERE charge_id = ? ORDER BY created_at, id")
+    .all(chargeId)
+    .map((row) => ({ ...row }) as unknown as Refund);
+}
diff --git a/test/refunds.test.ts b/test/refunds.test.ts
new file mode 100644
index 0000000..fc9207f
--- /dev/null
+++ b/test/refunds.test.ts
@@ -0,0 +1,63 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { createTestContext, seedSubscription, type TestContext } from "./helpers.ts";
+
+async function firstCharge(t: TestContext, subscriptionId: string): Promise<string> {
+  const charges = await t.call("GET", `/subscriptions/${subscriptionId}/charges`);
+  return charges.body.data[0].id;
+}
+
+describe("refunds", () => {
+  it("records partial refunds up to the charged amount", async () => {
+    const t = createTestContext();
+    const { subscriptionId } = await seedSubscription(t, { price_cents: 4990 });
+    const chargeId = await firstCharge(t, subscriptionId);
+
+    const r1 = await t.call("POST", `/charges/${chargeId}/refunds`, { amount_cents: 2000, reason: "damaged box" });
+    assert.equal(r1.status, 201);
+    assert.equal(r1.body.reason, "damaged box");
+
+    const over = await t.call("POST", `/charges/${chargeId}/refunds`, { amount_cents: 2991 });
+    assert.equal(over.status, 422);
+    assert.equal(over.body.error.details.remaining_cents, 2990);
+
+    const r2 = await t.call("POST", `/charges/${chargeId}/refunds`, { amount_cents: 2990 });
+    assert.equal(r2.status, 201);
+    assert.equal(r2.body.reason, null);
+
+    const list = await t.call("GET", `/charges/${chargeId}/refunds`);
+    assert.deepEqual(
+      list.body.data.map((r: { amount_cents: number }) => r.amount_cents),
+      [2000, 2990],
+    );
+
+    const events = await t.call("GET", `/subscriptions/${subscriptionId}/events`);
+    const refunded = events.body.data.filter((e: { type: string }) => e.type === "charge.refunded");
+    assert.deepEqual(
+      refunded.map((e: { payload: { refunded_total_cents: number } }) => e.payload.refunded_total_cents),
+      [2000, 4990],
+    );
+  });
+
+  it("validates the amount and the charge", async () => {
+    const t = createTestContext();
+    const { subscriptionId } = await seedSubscription(t);
+    const chargeId = await firstCharge(t, subscriptionId);
+    assert.equal((await t.call("POST", `/charges/${chargeId}/refunds`, { amount_cents: 1.5 })).status, 400);
+    assert.equal((await t.call("POST", `/charges/${chargeId}/refunds`, { amount_cents: 0 })).status, 400);
+    assert.equal((await t.call("POST", "/charges/ch_missing/refunds", { amount_cents: 1 })).status, 404);
+  });
+
+  it("refuses to refund a failed charge", async () => {
+    const t = createTestContext({ now: "2026-01-10T12:00:00.000Z" });
+    const { subscriptionId } = await seedSubscription(t);
+    t.setNow("2026-02-10T12:00:00.000Z");
+    t.gateway.failNext("card_declined");
+    await t.app.billing.runDueRenewals();
+    const charges = await t.call("GET", `/subscriptions/${subscriptionId}/charges`);
+    const failed = charges.body.data.find((c: { status: string }) => c.status === "failed");
+    const res = await t.call("POST", `/charges/${failed.id}/refunds`, { amount_cents: 100 });
+    assert.equal(res.status, 409);
+    assert.equal(res.body.error.code, "charge_not_refundable");
+  });
+});
