+import { withTransaction, type Database } from "../db/database.ts";
+import type { Refund } from "../domain/types.ts";
+import type { Clock } from "../lib/clock.ts";
+import { AppError, ConflictError, NotFoundError, ValidationError } from "../lib/errors.ts";
+import type { IdGenerator } from "../lib/ids.ts";
+import { isCents } from "../lib/money.ts";
+import { findCharge } from "../repositories/charges.ts";
+import { appendEvent } from "../repositories/events.ts";
+import { insertRefund, sumRefundedCents } from "../repositories/refunds.ts";
+
+export class RefundExceedsChargeError extends AppError {
+  constructor(remainingCents: number) {
+    super(422, "refund_exceeds_charge", `only ${remainingCents} cents of this charge can still be refunded`, {
+      remaining_cents: remainingCents,
+    });
+  }
+}
+
+/**
+ * Records a (partial) refund of a succeeded charge. The money itself is
+ * returned by finance in the processor dashboard; this keeps our books.
+ * The check and the insert run in one synchronous transaction, so two
+ * refunds can never exceed the charged amount together.
+ */
+export function createRefund(
+  deps: { db: Database; clock: Clock; ids: IdGenerator },
+  chargeId: string,
+  input: { amount_cents: unknown; reason: string | null },
+): Refund {
+  const { db, clock, ids } = deps;
+  const amount = input.amount_cents;
+  if (!isCents(amount) || amount === 0) {
+    throw new ValidationError("amount_cents must be a positive integer number of cents", { field: "amount_cents" });
+  }
+  const charge = findCharge(db, chargeId);
+  if (!charge) throw new NotFoundError("charge", chargeId);
+  if (charge.status !== "succeeded") {
+    throw new ConflictError(
+      "charge_not_refundable",
+      `charge ${chargeId} is ${charge.status}; only succeeded charges can be refunded`,
+    );
+  }
+
+  return withTransaction(db, () => {
+    const alreadyRefunded = sumRefundedCents(db, charge.id);
+    const remaining = charge.amount_cents - alreadyRefunded;
+    if (amount > remaining) throw new RefundExceedsChargeError(remaining);
+    const now = clock().toISOString();
+    const refund = insertRefund(db, {
+      id: ids("re"),
+      charge_id: charge.id,
+      subscription_id: charge.subscription_id,
+      amount_cents: amount,
+      reason: input.reason,
+      created_at: now,
+    });
+    appendEvent(db, ids, {
+      type: "charge.refunded",
+      subscription_id: charge.subscription_id,
+      charge_id: charge.id,
+      payload: { refund_id: refund.id, amount_cents: amount, refunded_total_cents: alreadyRefunded + amount },
+      occurred_at: now,
+    });
+    return refund;
+  });
+}
