new file mode 100644
index 0000000..e0b131a
--- /dev/null
+++ b/src/reports/revenue.ts
@@ -0,0 +1,49 @@
+import type { Database } from "../db/database.ts";
+import { ValidationError } from "../lib/errors.ts";
+import { formatCentsAsDecimal } from "../lib/money.ts";
+
+export interface RevenueRow {
+  charge_id: string;
+  subscription_id: string;
+  customer_id: string;
+  charged_at: string;
+  amount_cents: number;
+}
+
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}(T[\d:.]+Z)?$/;
+
+/** Succeeded charges in [from, to), oldest first. Amounts stay integer cents. */
+export function listRevenue(db: Database, range: { from: string | null; to: string | null }): RevenueRow[] {
+  for (const [name, value] of Object.entries(range)) {
+    if (value !== null && !ISO_DATE.test(value)) {
+      throw new ValidationError(`${name} must be an ISO date (YYYY-MM-DD)`, { field: name });
+    }
+  }
+  return db
+    .prepare(
+      `SELECT id AS charge_id, subscription_id, customer_id, created_at AS charged_at, amount_cents
+         FROM charges
+        WHERE status = 'succeeded'
+          AND (? IS NULL OR created_at >= ?)
+          AND (? IS NULL OR created_at < ?)
+        ORDER BY created_at, id`,
+    )
+    .all(range.from, range.from, range.to, range.to)
+    .map((row) => ({ ...row }) as unknown as RevenueRow);
+}
+
+export const REVENUE_CSV_HEADER = ["charge_id", "subscription_id", "customer_id", "charged_at", "amount_reais"];
+
+/**
+ * CSV for finance. The reais column is formatted at export time from the
+ * stored integer cents (AGENTS.md, invariant 1); nothing converted is stored.
+ */
+export function toRevenueCsv(rows: readonly RevenueRow[]): string {
+  const lines = [REVENUE_CSV_HEADER.join(",")];
+  for (const row of rows) {
+    lines.push(
+      [row.charge_id, row.subscription_id, row.customer_id, row.charged_at, formatCentsAsDecimal(row.amount_cents)].join(","),
+    );
+  }
+  return `${lines.join("\n")}\n`;
+}
diff --git a/test/reports.test.ts b/test/reports.test.ts
