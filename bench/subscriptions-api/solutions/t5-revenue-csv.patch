@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { formatCentsAsDecimal } from "../src/lib/money.ts";
+import { createTestContext, seedSubscription } from "./helpers.ts";
+
+describe("formatCentsAsDecimal", () => {
+  it("formats from integers without float rounding", () => {
+    assert.equal(formatCentsAsDecimal(1990), "19.90");
+    assert.equal(formatCentsAsDecimal(7), "0.07");
+    assert.equal(formatCentsAsDecimal(0), "0.00");
+    assert.equal(formatCentsAsDecimal(10005), "100.05");
+    assert.equal(formatCentsAsDecimal(123456789), "1234567.89");
+    assert.throws(() => formatCentsAsDecimal(19.9));
+  });
+});
+
+describe("GET /reports/revenue.csv", () => {
+  it("lists succeeded charges in reais and filters by date", async () => {
+    const t = createTestContext({ now: "2026-01-10T12:00:00.000Z" });
+    await seedSubscription(t, { price_cents: 1990 });
+    t.setNow("2026-02-03T09:00:00.000Z");
+    await seedSubscription(t, { price_cents: 4990 });
+
+    const all = await t.call("GET", "/reports/revenue.csv");
+    assert.equal(all.status, 200);
+    assert.match(all.headers["content-type"] ?? "", /text\/csv/);
+    const lines = (all.body as string).trim().split("\n");
+    assert.equal(lines[0], "charge_id,subscription_id,customer_id,charged_at,amount_reais");
+    assert.deepEqual(
+      lines.slice(1).map((l) => l.split(",")[4]),
+      ["19.90", "49.90"],
+    );
+
+    const feb = await t.call("GET", "/reports/revenue.csv?from=2026-02-01&to=2026-03-01");
+    assert.equal((feb.body as string).trim().split("\n").length, 2);
+
+    assert.equal((await t.call("GET", "/reports/revenue.csv?from=yesterday")).status, 400);
+  });
+});
