+++ b/src/http/handlers/reports.ts
@@ -0,0 +1,17 @@
+import { listRevenue, toRevenueCsv } from "../../reports/revenue.ts";
+import type { AppContext } from "../context.ts";
+import type { Router } from "../router.ts";
+
+export function registerReportRoutes(router: Router, ctx: AppContext): void {
+  router.get("/reports/revenue.csv", ({ req }) => {
+    const rows = listRevenue(ctx.db, { from: req.query.get("from"), to: req.query.get("to") });
+    return {
+      status: 200,
+      headers: {
+        "content-type": "text/csv; charset=utf-8",
+        "content-disposition": 'attachment; filename="revenue.csv"',
+      },
+      body: toRevenueCsv(rows),
+    };
+  });
+}
